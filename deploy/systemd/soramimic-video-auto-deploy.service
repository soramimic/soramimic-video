[Unit]
Description=Deploy Soramimic Video branch heads to their environments
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/soramimic-video-auto-deploy
TimeoutStartSec=infinity
TimeoutStopSec=infinity
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/soramimic-video-dev /opt/soramimic-video-preview /opt/soramimic-video-public
ReadWritePaths=/var/lib/soramimic-video-dev /var/lib/soramimic-video-preview
ReadWritePaths=/var/lib/soramimic-video-public /var/lib/soramimic-video-deployer /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
LockPersonality=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
SystemCallArchitectures=native
