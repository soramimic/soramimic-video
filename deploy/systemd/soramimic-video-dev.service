[Unit]
Description=Soramimic Video dev API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soramimic-video
Group=soramimic-video
WorkingDirectory=/opt/soramimic-video-dev/current
EnvironmentFile=/etc/soramimic-video/dev.env
Environment=HOME=/var/lib/soramimic-video-dev/work
Environment=PYTHONUNBUFFERED=1
Environment=SORAMIMIC_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
Environment=SORAMIMIC_ALLOW_LOCAL_OPS=1
ExecStart=/opt/soramimic-video-dev/current/.venv/bin/soramimic-video serve --host 127.0.0.1 --port 8311 --jobs-dir /var/lib/soramimic-video-dev/work/api-jobs --voicevox-url http://127.0.0.1:50021
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
StateDirectory=soramimic-video-dev/work
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
SystemCallArchitectures=native
MemoryHigh=6G
MemoryMax=8G
CPUQuota=400%
TasksMax=256

[Install]
WantedBy=multi-user.target
