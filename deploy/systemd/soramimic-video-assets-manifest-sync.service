[Unit]
Description=Synchronize changed Soramimic Release image assets from source manifest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=soramimic-video
Group=soramimic-video
SupplementaryGroups=soramimic-video-dev
WorkingDirectory=/opt/soramimic-video-dev/current
Environment=PYTHONUNBUFFERED=1
Environment=SORAMIMIC_VIDEO_ASSET_STORE=/var/lib/soramimic-video-assets
ExecStart=/opt/soramimic-video-dev/current/.venv/bin/soramimic-video sync-assets --mode manifest --download-workers 2 --priority-wordlist stations --priority-wordlist nations --priority-wordlist baseball --priority-wordlist scientist --priority-wordlist gimukyoiku
TimeoutStartSec=infinity
StateDirectory=soramimic-video-assets
StateDirectoryMode=0750
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/soramimic-video-assets
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
