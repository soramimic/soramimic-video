{
  "_comment": [
    "歌唱がない区間(前奏=intro / 間奏=interlude / 後奏=outro)の既定の表示定義。",
    "書式は layouts/*.json の elements と同じで、参照できる列は layout.py の",
    "冒頭のドキュメントを参照(interlude_sec / used_words / page など)。",
    "レイアウトJSON側に同名のキーを書くとそのレイアウトではそちらが使われ、",
    "空配列を書けばその区間の専用表示を無効化できる(従来の idle に戻る)。",
    "intro は既定なし(前奏にはサムネイルを出すため)。",
    "credits は後奏の最後に1枚出すクレジットページ(単語ページの残り時間を全部使う)。",
    "画像の帰属表示は各単語フレームの右下に個別に焼き込んでいるので、",
    "後奏でまとめて出す({image_credits})ことはしない。"
  ],
  "interlude": [
    {"type": "text", "text": "♪", "box": [0.1, 0.36, 0.8, 0.10],
     "size": 0.075, "color": "#8a8a8a", "align": "center"},
    {"type": "text", "text": "間奏({interlude_sec}秒)", "box": [0.1, 0.49, 0.8, 0.12],
     "size": 0.085, "color": "white", "align": "center"}
  ],
  "outro": [
    {"type": "text", "text": "使った単語{page_label}", "box": [0.06, 0.06, 0.88, 0.07],
     "size": 0.042, "color": "#a8a8a8", "align": "center"},
    {"type": "text", "text": "{used_words}", "box": [0.08, 0.17, 0.84, 0.74],
     "size": 0.05, "color": "white", "align": "left", "valign": "middle",
     "columns": 8}
  ],
  "credits": [
    {"type": "text", "text": "Credits", "box": [0.1, 0.08, 0.8, 0.07],
     "size": 0.042, "color": "#a8a8a8", "align": "center"},
    {"type": "text", "text": "Original Song　{original_song}", "box": [0.08, 0.19, 0.84, 0.09],
     "size": 0.052, "color": "white", "align": "center", "require": "original_song"},
    {"type": "text", "text": "{original_credit}", "box": [0.08, 0.29, 0.84, 0.10],
     "size": 0.041, "color": "white", "align": "center", "require": "original_credit"},
    {"type": "text", "text": "{credit_notice}", "box": [0.08, 0.40, 0.84, 0.12],
     "size": 0.036, "color": "#e0e0e0", "align": "center", "require": "credit_notice"},
    {"type": "text", "text": "Parody Lyrics & Video　Soramimic", "box": [0.1, 0.56, 0.8, 0.08],
     "size": 0.05, "color": "white", "align": "center"},
    {"type": "text", "text": "Vocal Synthesis　{synth_credit}", "box": [0.1, 0.65, 0.8, 0.07],
     "size": 0.042, "color": "white", "align": "center", "require": "synth_credit"},
    {"type": "text", "text": "soramimic.com / video.soramimic.com", "box": [0.1, 0.78, 0.8, 0.05],
     "size": 0.035, "color": "#a8a8a8", "align": "center"}
  ]
}
